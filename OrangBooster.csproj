<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OrangBooster</RootNamespace>
    <Version>8.0.0</Version>
    <AssemblyVersion>8.0.0.0</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
    <Company>OrangStudio</Company>
    <Authors>OrangStudio</Authors>
    <Publisher>OrangStudio</Publisher>
    <Product>OrangBooster</Product>
    <Trademark>Orang</Trademark>
    <Copyright>© 2026 OrangStudio</Copyright>
    <Description>OrangBooster - Windows optimization and debloat tool by OrangStudio.</Description>
    <AssemblyTitle>OrangBooster</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86</Platforms>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets\OrangBooster.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Other debloaters\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\OrangBooster.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\applications.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\edge.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\winutil.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="debloat_execute_external_scripts.py" />
    <None Remove="debloat_registry_tweaks.py" />
    <None Remove="all_of_commands.txt" />
    <None Remove="Assets\ralphs.ps1" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>True</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <PropertyGroup>
    <OrangSignPfx>$(MSBuildProjectDirectory)\OrangStudio.pfx</OrangSignPfx>
    <OrangSignPassword>OrangStudio!2026</OrangSignPassword>
    <OrangTimestampUrl>http://timestamp.digicert.com</OrangTimestampUrl>
  </PropertyGroup>
  <Target Name="SignPublishedExe" AfterTargets="Publish" Condition="Exists('$(OrangSignPfx)')">
    <ItemGroup>
      <_OrangSignTool Include="$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\**\x86\signtool.exe" />
    </ItemGroup>
    <PropertyGroup>
      <_OrangSignToolPath>@(_OrangSignTool->'%(FullPath)')</_OrangSignToolPath>
      <_OrangPublishedExe>$(PublishDir)$(TargetName).exe</_OrangPublishedExe>
    </PropertyGroup>
    <Message Importance="high" Text="Signing $(_OrangPublishedExe) with OrangStudio certificate" />
    <Exec Command="&quot;$(_OrangSignToolPath)&quot; sign /f &quot;$(OrangSignPfx)&quot; /p $(OrangSignPassword) /fd SHA256 /tr $(OrangTimestampUrl) /td SHA256 &quot;$(_OrangPublishedExe)&quot;" ContinueOnError="true" />
  </Target>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(PublishSingleFile)' == 'true'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishSingleFile)' != 'true' And '$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishSingleFile)' != 'true' And '$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <PackageCertificateThumbprint>CAD7D99F9E7540EA75096AA7A3E57503E8844F45</PackageCertificateThumbprint>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  </PropertyGroup>
</Project>