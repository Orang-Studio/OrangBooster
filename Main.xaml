<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OrangBooster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OrangBooster"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OrangBooster">
    <Grid>
        <Grid.Resources>
            <SolidColorBrush x:Key="FossBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="ProprietaryBrush" Color="#E53935"/>
            <SolidColorBrush x:Key="OrangAccentBrush" Color="#FF8800"/>
            <Style x:Key="ActionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="32" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarLogo" Grid.Column="0" Width="16" Height="16" Margin="12,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AppTitleTextBlock" Grid.Column="1" Text="OrangBooster" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{StaticResource FossBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="STABLE BUILD" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <TextBlock Text="v8.0.0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="NavView" Grid.Row="1" SelectionChanged="NavView_SelectionChanged" PaneDisplayMode="LeftCompact" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Booster" Content="Booster">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Debloater" Content="Debloater">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="AppsInstaller" Content="Apps Installer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Content="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid x:Name="ContentArea" Margin="24">
                <Grid x:Name="BoosterPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0">
                        <ItemsRepeater ItemsSource="{x:Bind BoosterCards, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="320" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:BoosterCard">
                                    <Border Style="{StaticResource ActionCardStyle}" ToolTipService.ToolTip="{x:Bind Functions}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="6,2" Background="{x:Bind TagBrush}" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind TagGlyph}" FontSize="11" Foreground="White"/>
                                                        <TextBlock Text="{x:Bind TagLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Row="2" Text="{x:Bind Functions}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"/>
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressRing Grid.Column="0" Width="16" Height="16" IsActive="True" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <CheckBox Grid.Column="2" Content="Enable" IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BoosterExecuteButton" Content="Execute Selected" Style="{ThemeResource AccentButtonStyle}" Click="ExecuteBooster_Click"/>
                            <Button Content="Select Recommended" Click="SelectRecommendedBooster_Click"/>
                            <Button Content="Select All" Click="SelectAllBooster_Click"/>
                            <Button Content="Deselect All" Click="DeselectAllBooster_Click"/>
                            <ProgressRing x:Name="BoosterProgress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BoosterStatus" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <AutoSuggestBox Grid.Column="1" x:Name="BoosterSearchBox" PlaceholderText="Search tweaks..." QueryIcon="Find" HorizontalAlignment="Right" Width="280" Margin="16,0,0,0" VerticalAlignment="Center" TextChanged="BoosterSearchBox_TextChanged"/>
                    </Grid>
                </Grid>
                <Grid x:Name="DebloaterPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="System Debloater" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Debloat your pc more effectively and without breaking anything." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource ActionCardStyle}">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="DebloatCtt" Content="CTT WinUtil tweak pack" FontWeight="SemiBold" IsChecked="True"/>
                                    <TextBlock Text="Runs the default WinUtil tweak set (telemetry, services, debloat, dark mode, classic menu, Xbox removal, AI off, etc.)." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ActionCardStyle}">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="DebloatRaphi" Content="Raphi Win11Debloat default profile" FontWeight="SemiBold" IsChecked="True"/>
                                    <TextBlock Text="-RemoveApps -DisableTelemetry -DisableBing -RevertContextMenu -TaskbarAlignLeft -DisableWidgets -DisableCopilot -DisableRecall -DisableClickToDo -DisableDVR ... (full default set, silent)." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ActionCardStyle}">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="DebloatApps" Content="App uninstaller (100+ bloatware appx)" FontWeight="SemiBold" IsChecked="True"/>
                                    <TextBlock Text="Aggressive Get-AppxPackage / Remove-AppxProvisionedPackage sweep using the OrangBooster bloatware list." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ActionCardStyle}">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="DebloatEdge" Content="Edge remover (AveYo)" FontWeight="SemiBold" IsChecked="True"/>
                                    <TextBlock Text="Runs the bundled edge.bat to remove Edge (WebView2 kept)." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ActionCardStyle}">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="DebloatOb" Content="OrangBooster registry pack" FontWeight="SemiBold" IsChecked="True"/>
                                    <TextBlock Text="adasjusk's registry config: long paths, verbose BSoD, hide Task View, taskbar left, hidden file ext, Microsoft account removal, Settings home page removal, etc." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button x:Name="DebloaterNukeButton" Content="Nuclear Debloat" Style="{ThemeResource AccentButtonStyle}" Click="NukeDebloater_Click"/>
                        <Button x:Name="DebloaterExecuteButton" Content="Execute Selected" Click="ExecuteDebloater_Click"/>
                        <Button Content="Select All" Click="DebloaterSelectAll_Click"/>
                        <Button Content="Select Recommended" Click="DebloaterRecommended_Click"/>
                        <ProgressRing x:Name="DebloaterProgress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebloaterStatus" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DebloaterLogLine" VerticalAlignment="Center" FontSize="12" Opacity="0.55" MaxWidth="460" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="AppsInstallerPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="16" Margin="0,0,0,16">
                        <TextBlock Text="Apps Installer" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <AutoSuggestBox x:Name="AppsSearchBox" PlaceholderText="Search for apps..." QueryIcon="Find" TextChanged="AppsSearchBox_TextChanged"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsRepeater ItemsSource="{x:Bind FilteredApps, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="380" MinItemHeight="110" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:AppItem">
                                    <Border Style="{StaticResource ActionCardStyle}" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0" IsChecked="{x:Bind Selected, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Content="Install" VerticalAlignment="Center" Margin="0,0,12,0" Tag="{x:Bind Id}" Click="InstallSingleApp_Click"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource FossBrush}" Visibility="{x:Bind FossVisibility}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="FOSS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FossBrush}" Visibility="{x:Bind FossVisibility}" VerticalAlignment="Center"/>
                                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource ProprietaryBrush}" Visibility="{x:Bind ProprietaryVisibility}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Proprietary" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ProprietaryBrush}" Visibility="{x:Bind ProprietaryVisibility}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Install/Update Selected" Style="{ThemeResource AccentButtonStyle}" Click="InstallSelectedApps_Click"/>
                        <Button Content="Install Chocolatey" Click="InstallChocolatey_Click"/>
                        <ProgressRing x:Name="AppsProgressRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppsStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="24">
                            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <ComboBox Header="App Theme" x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="0" Width="200">
                                    <ComboBoxItem Content="Default"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Logging" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <CheckBox x:Name="LoggingEnabledCheck" Content="Write a log file for every session" IsChecked="True" Checked="LoggingEnabled_Changed" Unchecked="LoggingEnabled_Changed"/>
                                <TextBlock x:Name="LogPathText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open Current Log" Click="OpenCurrentLog_Click"/>
                                    <Button Content="Open Log Folder" Click="OpenLogFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock Text="About" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image x:Name="AboutLogo" Width="64" Height="64"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OrangBooster - v8.0.0" FontSize="16"/>
                                        <TextBlock Text="Made by adasjusk and vakarux" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="OrangStudio © 2026" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Thanks for using our programs ❤️" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>